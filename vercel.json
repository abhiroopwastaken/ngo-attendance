{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?_api_path=$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js?_upload_file=$1"
    }
  ]
}
